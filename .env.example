# Application
DEV__ENVIRONMENT=development
DEV__PROJECT_NAME=Python Project Management
DEV__API_STR=/api
DEV__LOG_LEVEL=INFO

# JWT
# Generate with: python artisan.py init
API__AUTH0__SECRET_KEY=please-change-me
API__AUTH0__ACCESS_TOKEN_EXPIRE_MINUTES=129600

# MySQL
DB__HOST=127.0.0.1
DB__USERNAME=root
DB__PASSWORD=please-change-me
DB__DATABASE=python_project_management
DB__TIMEZONE=Asia/Shanghai

# Redis, optional
REDIS__HOST=127.0.0.1
REDIS__DATABASE=0
REDIS__PREFIX=python_project_management:

# Project path defaults
PROJECT_PATHS__ROOT_BASE_PATH=/root/project
PROJECT_PATHS__USER_BASE_PATH_TEMPLATE=/home/{username}/project
